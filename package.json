{
  "name": "huiyuan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "回源 · KNOWLEDGE SPACE — 可溯源、可自测的知识网络",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:server\"",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "node tools/build-single.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
}
