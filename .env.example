# 复制为 .env 后填写；.env 不会提交进仓库（见 .gitignore）
# 任意 OpenAI 兼容服务均可：DeepSeek / OpenAI / 自建网关
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 后端端口。Vite 开发代理固定指向 3001，改端口需同步 vite.config.ts
PORT=3001

# 单块抽取调用超时（毫秒）
LLM_TIMEOUT_MS=90000
# ---- Supabase（可选，不填则自动使用本地 JSON 文件存储）----
# 在 Supabase Dashboard → Project Settings → API 获取
SUPABASE_URL=https://xwjcplglqymmtucbzrqr.supabase.co
# 服务端最高权限密钥，仅后端使用（Vercel Environment Variable 里配置）
SUPABASE_SERVICE_ROLE_KEY=
# 前端公开密钥（带 NEXT_PUBLIC_ 前缀会自动暴露给浏览器）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
