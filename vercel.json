{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "regions": ["hkg1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "{server/**/*.ts,src/lib/**/*.ts}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" }
  ]
}
